---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import ProductoCard from "../components/ProductoCard.astro";

interface Producto {
  id: number;
  title: string;
  price: number;
  category: string;
  rating: number;
  thumbnail: string;
}

let productos: Producto[] = [];
let mensajeError = "";

try {
  const respuesta = await fetch("https://dummyjson.com/products?limit=12");
  if (!respuesta.ok) {
    throw new Error(`Error HTTP: ${respuesta.status}`);
  }
  const datos = await respuesta.json();
  productos = datos.products ?? [];
} catch (error) {
  console.error("Error al consultar la API:", error);
  mensajeError = "No fue posible cargar los productos.";
}
---

<Layout title="Catálogo de productos">
  <main>
    <h1>Catálogo de productos</h1>
    <p class="subtitulo">Explora nuestro catálogo de demostración.</p>

    <!-- Buscador de productos -->
    <div class="buscador-container">
      <label for="buscador">Buscar producto</label>
      <input 
        id="buscador" 
        type="search" 
        placeholder="Escribe un nombre..." 
        aria-label="Buscar producto por nombre"
      />
    </div>

    <!-- Manejo de Errores -->
    {mensajeError && <p class="alerta-error" role="alert">{mensajeError}</p>}

    <!-- Ausencia de productos desde la API -->
    {!mensajeError && productos.length === 0 && (
      <p class="alerta-vacio">No hay productos disponibles para mostrar.</p>
    )}

    <!-- Renderización dinámica de productos -->
    {!mensajeError && productos.length > 0 && (
      <>
        <section class="grid-productos" id="grid-productos">
          {productos.map((producto) => (
            <ProductoCard
              title={producto.title}
              price={producto.price}
              category={producto.category}
              rating={producto.rating}
              thumbnail={producto.thumbnail}
            />
          ))}
        </section>

        <!-- Mensaje de sin coincidencias en el buscador del cliente -->
        <p id="sin-coincidencias" class="alerta-vacio" hidden>
          No se encontraron productos que coincidan con la búsqueda.
        </p>
      </>
    )}
  </main>
</Layout>

<!-- Script para el Buscador Interactivo en el Navegador -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buscador = document.querySelector("#buscador") as HTMLInputElement | null;
    const tarjetas = document.querySelectorAll(".producto");
    const mensajeSinCoincidencias = document.querySelector("#sin-coincidencias");

    if (buscador) {
      buscador.addEventListener("input", () => {
        const textoBusqueda = buscador.value.toLowerCase().trim();
        let tarjetasVisibles = 0;

        tarjetas.forEach((tarjeta) => {
          const elementoTarjeta = tarjeta as HTMLElement;
          const titulo = elementoTarjeta.dataset.title ?? "";

          if (titulo.includes(textoBusqueda)) {
            elementoTarjeta.removeAttribute("hidden");
            tarjetasVisibles++;
          } else {
            elementoTarjeta.setAttribute("hidden", "");
          }
        });

        if (mensajeSinCoincidencias) {
          if (tarjetasVisibles === 0) {
            mensajeSinCoincidencias.removeAttribute("hidden");
          } else {
            mensajeSinCoincidencias.setAttribute("hidden", "");
          }
        }
      });
    }
  });
</script>